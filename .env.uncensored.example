# Copy to .env.uncensored. Prepare .env first. Use scripts/uncensored.sh for this option.
# shellcheck source=.env.example
. "$ROOT/.env"

# Use the engine revision in docs/UNCENSORED.md. The base image does not support BF16 overrides.
TF_COMMIT=6c53993796efddcb0a80fafc49fa2d952544eda2
IMAGE=tensorfold-dsv41:6c53993796ef

# The paths must match on both nodes. The preparation script creates this new view.
MODEL_VIEW=$HOME/models/deepseek-v41-1017-dealign-bf16
# Each override SHA256 has its own cache root. Do not point this at a base cache.
CACHE_DIR=$HOME/tfv41-uncensored-cache/${UNCENSORED_CACHE_ID:-unverified}
SERVED_NAME=DeepSeek-V4.1-Flash-1017-UNCENSORED-BF16
SERVED_ALIAS=
TF_DS_PREFILL_CHUNK=1024
MEM_FLOOR_GIB=1.5
CONTEXT=1048576
